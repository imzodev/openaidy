# ---------------------------------------------------------------------------
# OpenAidy environment configuration
#
# Copy this file to `.env` at the repo root (or run `pnpm dev:setup`) and fill
# in the values you need. Everything here is OPTIONAL — OpenAidy runs zero-config
# out of the box:
#   - SQLite is the default database (no setup required)
#   - The JWT signing secret and the credentials master key are generated and
#     persisted automatically on first boot (see $OPENAIDY_HOME/state)
#
# The only thing most people set is one or more provider API keys below so the
# agent has a model to talk to. You can also connect providers from the UI
# (Settings → Providers) instead of using env vars.
# ---------------------------------------------------------------------------

# --- Provider API keys (set the ones you use) ------------------------------
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Google Gemini — either name is accepted
GOOGLE_API_KEY=your_google_key_here
# GEMINI_API_KEY=your_google_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
ZAI_API_KEY=your_zai_key_here
MINIMAX_API_KEY=your_minimax_key_here
OPENCODE_ZEN_API_KEY=your_opencode_zen_key_here

# --- Web search tools (optional) -------------------------------------------
# BRAVE_API_KEY=your_brave_key_here
# TAVILY_API_KEY=your_tavily_key_here

# --- Server (optional — defaults shown) ------------------------------------
# NODE_ENV=development
# OPENAIDY_PORT=3001
# OPENAIDY_CORS_ORIGIN=http://localhost:5173
# LOG_LEVEL=info
# Root of persisted state (db, credentials, skills, workspaces). Defaults to
# `<repo>/.openaidy`.
# OPENAIDY_HOME=/absolute/path/to/openaidy-home

# --- Database (optional) ---------------------------------------------------
# Default is SQLite and needs no configuration.
# DB_KIND=sqlite
# SQLITE_PATH=./.openaidy/data/openaidy.db
#
# To use PostgreSQL instead, set DB_KIND=postgres and provide DATABASE_URL:
# DB_KIND=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/openaidy

# --- Advanced / production (optional) --------------------------------------
# Both are auto-generated and persisted per install when unset. Set them
# explicitly for containerized, rotated, or shared-key deployments.
# WS_TOKEN_SECRET=            # >= 32 chars; signs WebSocket/admin JWTs
# CREDENTIALS_MASTER_KEY=     # >= 32 chars; encrypts stored provider creds (AES-256-GCM)

# --- Feature flags (optional) ----------------------------------------------
# RECURRING_TASKS_ENABLED=false
