{
  "name": "openaidy",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:landing": "pnpm --filter ./landing dev",
    "dev:server": "pnpm --filter ./apps/server dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "openaidy": "tsx packages/cli/bin/openaidy.ts"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,mts,cts,tsx}": [
      "eslint --fix"
    ]
  }
}
