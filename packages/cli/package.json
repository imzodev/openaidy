{
  "name": "@aidyagent/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "Aidy command-line interface for local administration",
  "bin": {
    "aidy": "./bin/aidy.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@aidyagent/addon-scaffolding": "workspace:*",
    "@aidyagent/config": "workspace:*",
    "@aidyagent/control-plane": "workspace:*",
    "@aidyagent/sdk": "workspace:*",
    "@aidyagent/server": "workspace:*",
    "@aidyagent/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./commands": "./src/commands/index.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "bin",
    "src"
  ],
  "keywords": [
    "aidy",
    "cli",
    "admin",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imzodev/aidy.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/imzodev/aidy/issues"
  },
  "homepage": "https://github.com/imzodev/aidy#readme"
}
