{
  "name": "@openaidy/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "OpenAidy command-line interface for local administration",
  "bin": {
    "openaidy": "./bin/openaidy.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
